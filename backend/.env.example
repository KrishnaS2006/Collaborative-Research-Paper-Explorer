# Server Configuration
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/research_explorer?sslmode=disable

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long

# Institutional Email Policy (comma-separated domains and subdomains)
# e.g., stanford.edu,mit.edu,edu,ac.in
ALLOWED_EMAIL_DOMAINS=edu,ac.in,stanford.edu,mit.edu,berkeley.edu,iisc.ac.in

# Email Verification & SMTP Service
# EMAIL_SERVICE_MODE: 'smtp' | 'console' | 'disabled'
EMAIL_SERVICE_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Collaborative Research Paper Explorer <no-reply@paperexplorer.local>"

# Rate Limiting Configuration
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5

RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
RESET_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5

RESEND_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
RESEND_VERIFICATION_RATE_LIMIT_MAX_ATTEMPTS=5

SSO_CALLBACK_RATE_LIMIT_WINDOW_MS=900000
SSO_CALLBACK_RATE_LIMIT_MAX_ATTEMPTS=10

# FR-02: Institutional Single Sign-On (Google Workspace / OIDC)
# Leave OIDC_CLIENT_ID and OIDC_CLIENT_SECRET blank to safely disable SSO in environments without credentials.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://accounts.google.com
OIDC_REDIRECT_URI=http://localhost:5000/api/auth/sso/callback
OIDC_BUTTON_TEXT=Sign in with Institutional Google Account
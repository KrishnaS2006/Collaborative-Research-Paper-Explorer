# ==============================================================================
# Collaborative Research Paper Explorer - Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Database Connection URL (PostgreSQL 13+)
# For local dev without SSL: sslmode=disable
# For Neon / cloud production: sslmode=require
DATABASE_URL=

# Optional DB SSL override ('true' or 'false')
DB_SSL=false

# JWT Secret Key
# SECURITY NOTE: Must be a random, high-entropy secret string.
# In production (NODE_ENV=production), the application enforces a minimum length of 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long

# Frontend URL (Used for constructing password reset email links)
FRONTEND_URL=http://localhost:5173

# Email Service Configuration
# Modes:
#   - 'smtp': Sends real emails via SMTP (e.g. Gmail SMTP)
#   - 'console': Logs reset links directly to stdout (development default)
#   - 'disabled': Disables email dispatching
EMAIL_SERVICE_MODE=smtp

# Gmail SMTP Configuration
# Instructions:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password under Security -> 2-Step Verification -> App passwords
# 3. Enter your full Gmail address in SMTP_USER and the 16-character App Password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=fkpx foee chlq spux
SMTP_FROM="Collaborative Research Paper Explorer" <shyamramani6@gmail.com>

# Development-Only: Include reset token in API response for automated testing
# SECURITY NOTE: Must be 'false' or omitted in production.
EXPOSE_DEV_RESET_TOKEN=false

# Rate Limiting Configuration (In-Memory)
# Note: In-memory rate limits apply per Node process instance.
# For multi-instance/clustered production deployments, configure a centralized Redis store.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5

RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
RESET_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5